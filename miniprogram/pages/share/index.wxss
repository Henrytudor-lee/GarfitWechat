/* pages/share/index.wxss — 训练分享页
   视觉语言跟首页/会话详情一致(深色 + 荧光绿主色), 但用的是独立页而不是弹框。 */

.page {
  min-height: 100vh;
  background: #131313;
  padding: 40rpx 28rpx 200rpx;
  box-sizing: border-box;
}

.page.theme-day {
  background: #f5f5f5;
}

/* ── 状态区(加载中 / 失效) ── */
.state-box {
  padding: 160rpx 40rpx;
  text-align: center;
}
.state-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}
.state-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #f2f2f2;
  margin-bottom: 12rpx;
}
.theme-day .state-title { color: #1a1a1a; }
.state-sub {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 30rpx;
}
.state-btn {
  display: inline-block;
  margin: 0 12rpx;
  padding: 22rpx 48rpx;
  border-radius: 999rpx;
  background: #ccf200;
  color: #000;
  font-size: 26rpx;
  font-weight: 800;
}

/* ── 分享者 + 训练摘要(同一行, 跟海报一致) ── */
.share-head {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.owner {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.owner-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.owner-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.owner-info {
  min-width: 0;
}
.owner-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #f2f2f2;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-day .owner-name { color: #1a1a1a; }
.owner-label {
  font-size: 20rpx;
  color: #8a8a8a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 摘要三块: 缩成小方块, 贴在头像那一行的右边 */
.summary {
  display: flex;
  gap: 8rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.summary-card {
  width: 112rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 14rpx;
  padding: 10rpx 4rpx;
  text-align: center;
  box-sizing: border-box;
}
.theme-day .summary-card {
  background: #ffffff;
  border-color: rgba(0, 0, 0, 0.06);
}
.summary-val {
  font-size: 24rpx;
  font-weight: 900;
  color: #ccf200;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.summary-label {
  font-size: 18rpx;
  color: #8a8a8a;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-line {
  font-size: 22rpx;
  color: #8a8a8a;
  margin-bottom: 24rpx;
  font-family: 'SF Mono', Menlo, monospace;
}

/* ── 动作分组 ── */
/* 动作卡: 图 + 动作名(下面挂大卡 tag) │ 竖虚线 │ 每组明细网格
   —— 跟分享海报同一套版式(海报那边是 canvas 手绘, 这里是 WXML) */
.group {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 22rpx;
  padding: 18rpx;
  margin-bottom: 18rpx;
}
.theme-day .group {
  background: #ffffff;
  border-color: rgba(0, 0, 0, 0.06);
}
.group-body {
  display: flex;
  align-items: stretch;
}
/* 宽度 = 图 64 + 间距 12 + 名字列 124 —— 名字列再宽就把右侧明细挤成两列了 */
.group-head {
  display: flex;
  align-items: center;
  width: 200rpx;
  flex-shrink: 0;
}
.group-img-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.05);
  margin-right: 12rpx;
  flex-shrink: 0;
}
.group-img {
  width: 100%;
  height: 100%;
}
.group-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
/* 名字 + 大卡 tag 上下排 —— tag 跟在名字后面会把名字挤成两三个字 */
.group-info {
  width: 124rpx;
  flex-shrink: 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}
.group-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #f2f2f2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  line-height: 1.2;
}
.theme-day .group-name { color: #1a1a1a; }
/* 大卡 tag —— 在动作名下面独占一行 */
.group-tag {
  align-self: flex-start;
  max-width: 100%;
  font-size: 16rpx;
  font-weight: 800;
  color: #ccf200;
  background: rgba(204, 242, 0, 0.14);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-day .group-tag {
  background: rgba(204, 242, 0, 0.2);
}
/* 竖虚线: 把「动作身份」和「训练数据」分开 */
.group-divider {
  width: 2rpx;
  align-self: stretch;
  margin: 0 10rpx;
  border-left: 2rpx dashed #333;
}
/* 明细网格: 一行三条(能塞几条塞几条, 跟海报同口径) */
.group-sets {
  flex: 1;
  min-width: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  align-content: start;
}
.set-item {
  display: flex;
  align-items: center;
  /* 超长文案(距离+时长+负重)放不下时整段换行, 不横向溢出到隔壁格子 */
  flex-wrap: wrap;
  align-content: center;
  gap: 2rpx;
  padding: 5rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.05);
  font-size: 18rpx;
  color: #d8d8d8;
  min-width: 0;
}
/* 英文的 "60kg×12reps" 比中文的 "60kg×12次" 长一截, 缩一号才塞得进一列 */
.locale-en .set-item {
  font-size: 16rpx;
}
.theme-day .set-item {
  background: rgba(0, 0, 0, 0.04);
  color: #333;
}
.set-num {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ccf200;
  color: #000;
  font-size: 12rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.set-text {
  flex: 1;
  min-width: 0;
  line-height: 1.3;
  word-break: break-all;
}
.set-strong { font-weight: 700; color: #fff; }
.theme-day .set-strong { color: #1a1a1a; }

/* ── 底部按钮 ── */
.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(19, 19, 19, 0.92);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.theme-day .foot {
  background: rgba(245, 245, 245, 0.94);
  border-top-color: rgba(0, 0, 0, 0.08);
}
.foot-btn {
  height: 92rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.foot-btn::after { border: none; }

.foot-btn-ghost {
  flex-shrink: 0;
  padding: 0 30rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #f2f2f2;
  font-size: 26rpx;
  font-weight: 700;
}
.theme-day .foot-btn-ghost {
  border-color: rgba(0, 0, 0, 0.16);
  color: #1a1a1a;
}

.foot-btn-main {
  flex: 1;
  background: #ccf200;
  color: #000;
}

/* 离屏画布: 生成海报用(见 index.wxml), 移到屏幕外。
   ⚠️ 千万别用 opacity:0 / display:none —— iOS 上不可见的画布不栅格化,
      wx.canvasToTempFilePath 会报 "fail on image"。
   宽高由 JS 动态设(wxml style 绑定), 要跟画布像素尺寸一致。 */
.poster-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  pointer-events: none;
}

/* ── 动作详情弹层 ── */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 78vh;
  background: #1a1a1a;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.sheet-scroll {
  flex: 1;
  min-height: 0;
}
.sheet-sets-title {
  font-size: 22rpx;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: #6a6a6a;
  margin-bottom: 14rpx;
}
/* 组列表: 一行两条 */
.sheet-sets-grid {
  display: flex;
  flex-wrap: wrap;
}
.sheet-set-row {
  width: 50%;
  flex-shrink: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 16rpx 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  font-size: 24rpx;
  color: #e0e0e0;
}
/* 奇数条 → 最后一条独占整行, 不留半格空白 */
.sheet-set-row.wide {
  width: 100%;
  padding-right: 0;
}
.sheet-set-text {
  flex: 1;
  min-width: 0;
  line-height: 1.35;
}
.sheet-set-num {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: #ccc;
  font-size: 17rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.sheet-foot {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom, 0px));
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 收藏按钮 —— 与动作库页同款(心形图标, 已收藏时高亮) */
.sheet-fav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-fav-btn.active {
  background: rgba(204, 242, 0, 0.18);
}
.sheet-fav-btn image {
  width: 38rpx;
  height: 38rpx;
}
.sheet-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
