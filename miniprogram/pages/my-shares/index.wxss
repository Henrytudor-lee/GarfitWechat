/* pages/my-shares/index.wxss — 我的分享 */

.page {
  min-height: 100vh;
  background: #131313;
  padding: 40rpx 28rpx 120rpx;
  box-sizing: border-box;
}
.page.theme-day { background: #f5f5f5; }

.state-box { padding: 160rpx 40rpx; text-align: center; }
.state-icon { font-size: 72rpx; margin-bottom: 24rpx; }
.state-title {
  font-size: 30rpx; font-weight: 800; color: #f2f2f2;
}
.theme-day .state-title { color: #1a1a1a; }

.item {
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
}
.theme-day .item {
  background: #ffffff;
  border-color: rgba(0, 0, 0, 0.06);
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.item-date {
  font-size: 26rpx;
  font-weight: 800;
  color: #f2f2f2;
}
.theme-day .item-date { color: #1a1a1a; }

/* 头部右侧: 分享类型 + 状态 */
.item-head-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.item-kind {
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(204, 242, 0, 0.14);
  color: #ccf200;
}

/* 动作分享的缩略图 + 动作名 */
.item-ex {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}
.item-ex-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.06);
}
.item-ex-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.item-ex-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #f2f2f2;
}
.theme-day .item-ex-name { color: #1a1a1a; }

.item-status {
  font-size: 20rpx;
  font-weight: 800;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.item-status-ACTIVE   { background: rgba(92,220,138,.16); color: #5ddc8a; }
.item-status-REVOKED  { background: rgba(255,107,107,.16); color: #ff6b6b; }
.item-status-EXPIRED  { background: rgba(255,180,84,.16); color: #ffb454; }
.item-status-DELETED  { background: rgba(255,255,255,.08); color: #8a8a8a; }

.item-stats {
  font-size: 24rpx;
  color: #b9b9b9;
  margin-bottom: 10rpx;
}
.item-dot { margin: 0 8rpx; color: #555; }
.item-expire {
  font-size: 20rpx;
  color: #6a6a6a;
  font-family: 'SF Mono', Menlo, monospace;
  margin-bottom: 14rpx;
}

/* 行底部: 左边"查看详情", 右边"取消分享" */
.item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}
.item-preview {
  font-size: 24rpx;
  color: #ccf200;
  font-weight: 700;
}

.revoke-btn {
  width: 240rpx;
  height: 76rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(255, 107, 107, 0.12);
  border: 1rpx solid rgba(255, 107, 107, 0.32);
  color: #ff6b6b;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}
