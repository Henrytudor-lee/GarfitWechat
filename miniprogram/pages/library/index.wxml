<!--pages/library/index.wxml—garcia-fitness-new style-->
<view class="page {{theme === 'day' ? 'theme-day' : 'theme-night'}}">

  <!-- Top App Bar -->
  <appbar theme="{{theme}}" />

  <!-- Fixed Filters Section -->
  <view class="filters-fixed">

  <!-- Page Header -->
  <view class="page-header">
    <view class="page-title">{{t.EXERCISE_LIBRARY}}</view>
    <view class="page-subtitle">{{t.ACCESS_7000PLUS_PROFESSIONAL_MOVEMENTS}}</view>
  </view>

  <!-- Search -->
  <view class="search-bar">
    <image class="search-icon" src="{{iconSearchUrl}}" mode="aspectFit" />
    <input
      class="search-input"
      placeholder="{{t.SEARCH_EXERCISES}}"
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <view class="filter-icons-wrap">
      <text
        class="filter-icon-btn {{filterFavor ? 'active' : ''}}"
        bindtap="onFavorFilterTap"
        hover-class="tap-active"
      >♥</text>
      <text
        class="filter-icon-btn filter-icon-btn-text {{filterPracticed ? 'active' : ''}}"
        bindtap="onPracticedFilterTap"
        hover-class="tap-active"
      >☑</text>
    </view>
  </view>

  <!-- Equipment Filters -->
  <view class="filter-section">
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-row">
        <view
          class="filter-chip {{selectedEquipment === null ? 'active' : ''}}"
          bindtap="onEquipmentTap"
          data-id="{{null}}"
        >{{t.ALL}} <text wx:if="{{selectedEquipment === null}}" class="equip-name">{{t.EQUIPS}}</text></view>
        <view
          wx:for="{{equipmentList}}"
          wx:key="id"
          class="filter-chip {{selectedEquipment === item.id ? 'active' : ''}}"
          bindtap="onEquipmentTap"
          data-id="{{item.id}}"
        >
          <image wx:if="{{item.icon}}" class="equip-icon" src="{{imgPrefix}}/equipment_icons/{{item.icon}}" mode="aspectFit" />
          <text wx:if="{{selectedEquipment === item.id}}" class="equip-name">{{locale === 'en' ? item.name : item.name_zh}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Muscle Filters -->
  <view class="filter-section">
    <scroll-view class="filter-scroll" scroll-x>
      <view class="filter-row">
        <view
          class="filter-chip {{selectedMuscle === null ? 'active' : ''}}"
          bindtap="onMuscleTap"
          data-id="{{null}}"
        >{{t.ALL}} <text wx:if="{{selectedMuscle === null}}" class="equip-name">{{t.MUSCLES}}</text></view>
        <view
          wx:for="{{muscleList}}"
          wx:key="id"
          class="filter-chip {{selectedMuscle === item.id ? 'active' : ''}}"
          bindtap="onMuscleTap"
          data-id="{{item.id}}"
        >
          <image wx:if="{{item.icon}}" class="equip-icon" src="{{imgPrefix}}/body-icons/{{item.icon}}" mode="aspectFit" />
          <text wx:if="{{selectedMuscle === item.id}}" class="equip-name">{{locale === 'en' ? item.name : item.name_zh}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  </view>
  <!-- /filters-fixed -->

  <!-- Scrollable Content -->
  <scroll-view class="content-scroll" scroll-y bindscrolltolower="loadMore" lower-threshold="100">
  <view wx:if="{{loading && list.length === 0}}" class="loading-state">{{t.LOADING}}</view>
  <view wx:elif="{{list.length === 0 && !loading && !loadError}}" class="empty-state">{{t.NO_EXERCISES_FOUND}}</view>
  <!-- 加载失败态: 不能和"没有找到动作"混为一谈 -->
  <view wx:elif="{{list.length === 0 && !loading && loadError}}" class="error-state">
    <text class="error-text">{{t.LOAD_FAILED || 'Load failed'}}</text>
    <text class="error-subtext">{{locale === 'zh' ? '加载失败, 点击重试' : 'Failed to load, tap to retry'}}</text>
    <button class="error-retry-btn" bindtap="onSearch">{{locale === 'zh' ? '重试' : 'RETRY'}}</button>
  </view>

  <view wx:else class="exercise-grid">
    <view
      class="exercise-card"
      wx:for="{{list}}"
      wx:key="id"
      data-item="{{item}}"
      bindtap="onExerciseTap"
    >
      <!-- Image -->
      <view class="card-img-wrap">
        <image
          wx:if="{{item.image_name}}"
          class="card-img"
          src="{{imgPrefix}}/exer_images/{{item.image_name}}"
          mode="aspectFill"
        />
        <view wx:else class="card-img-placeholder">🏋️</view>
        <view class="card-gradient"></view>
        <view wx:if="{{item.is_practiced}}" class="done-badge">{{t.DONE}}</view>
        <view wx:if="{{item.is_favorite}}" class="fav-icon-wrap" catchtap="onFavoriteTap" data-id="{{item.id}}">
          <image src="{{imgPrefix}}/icons/heart_filled.png" mode="aspectFit" />
        </view>
        <view wx:if="{{item.video_name}}" class="play-overlay">▶</view>
      </view>
      <!-- Card Footer -->
      <view class="card-footer">
        <view class="card-top">
          <view class="card-name">{{locale === 'en' ? item.name : (item.name_zh || item.name)}}</view>
        </view>
        <view class="card-tags">
          <image wx:if="{{item.equipment_icon}}" class="chip-icon" src="{{imgPrefix}}/equipment_icons/{{item.equipment_icon}}" mode="aspectFit" />
          <text class="chip chip-neutral">{{locale === 'en' ? item.equipment_name : (item.equipment_name_zh || item.equipment_name)}}</text>
          <text wx:if="{{item.muscle_name}}" class="chip">{{locale === 'en' ? item.muscle_name : (item.muscle_name_zh || item.muscle_name)}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">{{t.LOAD_MORE}}</view>
  <view wx:if="{{!hasMore && list.length > 0}}" class="no-more">— {{t.ALL}} —</view>

  </scroll-view>
  <!-- /content-scroll -->

  <!-- Exercise Detail Bottom Sheet -->
  <view class="sheet-mask {{selectedExercise ? 'show' : ''}}" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">

      <!-- Close Handle -->
      <view class="sheet-handle" bindtap="closeSheet"></view>

      <!-- Header with close -->
      <view class="sheet-header">
        <text class="sheet-title">{{selectedExercise.name_zh || selectedExercise.name}}</text>
        <view class="sheet-close" bindtap="closeSheet">✕</view>
      </view>

      <!-- Media: 固定在滚动区外(视频/图片/占位符 + 无视频提示)
           ⚠️ 动作详情被抽成了组件(exercise-detail), 训练分享页/动作分享页共用同一套。
              这里拆成两个实例: 媒体一个、内容一个 —— 保持"媒体不跟着内容滚"的原布局。 -->
      <exercise-detail
        variant="compact"
        show-body="{{false}}"
        exercise="{{selectedExercise}}"
        locale="{{locale}}"
        theme="{{theme}}"
        imgPrefix="{{imgPrefix}}"
        vidPrefix="{{vidPrefix}}"
        show-video-tip="{{true}}"
        tip-text="{{t.NO_DEMO_VIDEO_FOR_THIS_EXERCISE_YET}}"
        tip-sub-text="{{t.SHOWING_PREVIEW_IMAGE_ONLY}}"
      />

      <!-- Scrollable Content -->
      <scroll-view class="sheet-scroll" scroll-y>
        <view class="sheet-content">
          <exercise-detail
            variant="compact"
            show-media="{{false}}"
            show-title="{{false}}"
            exercise="{{selectedExercise}}"
            locale="{{locale}}"
            theme="{{theme}}"
          />
        </view>
      </scroll-view>

      <!-- Action Button -->
      <view class="sheet-action">
        <view
          class="sheet-fav-btn {{selectedExercise.is_favorite ? 'active' : ''}}"
          catchtap="onDetailFavTap"
          hover-class="tap-active"
        >
          <image
            src="{{imgPrefix}}/icons/heart{{selectedExercise.is_favorite ? '_filled' : ''}}.png"
            mode="aspectFit"
          />
        </view>
        <!-- 分享: open-type="share" 由页面级 onShareAppMessage 提供卡片内容 -->
        <button
          wx:if="{{!isSelectMode}}"
          class="sheet-share-btn"
          open-type="share"
        >{{t.SHARE}}</button>
        <button
          class="sheet-btn"
          bindtap="{{isSelectMode ? 'doSelect' : 'addToWorkout'}}"
          data-item="{{selectedExercise}}"
        >{{isSelectMode ? t.SELECT_EXERCISE : t.ADD_TO_WORKOUT}}</button>
      </view>
    </view>
  </view>

  <!-- Add Exercise Modal (for addToWorkout flow) -->
  <add-exercise-modal
    isOpen="{{showAddModal}}"
    sessionId="{{currentSessionId}}"
    preselectedExercise="{{preselectedExercise}}"
    theme="{{theme}}"
    bind:close="onAddModalClose"
    bind:exerciseadded="onAddModalExerciseAdded"
  />

  <!-- Custom Tab Bar -->
  <custom-tabbar active="library" theme="{{theme}}" />

  <!-- Session Orb (悬浮圆球) -->
  <session-orb session="{{orbSession}}" theme="{{theme}}" bind:orb-tap="onOrbTap" />

</view>
